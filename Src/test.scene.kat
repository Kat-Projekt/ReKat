// projekt metadata
projekt = Test;

graphik = true;
phisiks = 120;
synth = true;
katwork = true;

entry_point = "giovanni muciaccia";

// reasurces
.resources {
	texture { 
		"texture 1" [ "Path\to\texture" ] ,
		"texture 2" [ "antorher\path\to\text" ] ,
		"texture 2" [ "antorher\path\to\text" ] ,
		"texture 2" [ "antorher\path\to\text" ] 
	},

	shader {
		"shader 1" [ "vertex.vs", "fragment.fs" ],
		"shader 2" [ "vertex.vs", "fragment.fs", "geometry.gs", "tessControl.tcs", "tessEval.tes" ]
	},

	type_of_reaurce {
		"risorsa" [ "arg1", 3, 0.123 ] 
	}
}
// custom components
.components {
	"Path \to\component.cpp",
	"second\file"
}
// objekts
.objekts {
	"pippo franco" { //ciccio
		attributes [ { 0,0,0 }, "coks", "bals"],
		components [ Sprite, Camera ]
	},
	"giovanni muciaccia" { //ciccio
		components [ Sprite [ "teticolo", "sinistro" ], Camera ],
		childs [ "pippo franco"]
	} 
}
