#include "@COMP@_wrapper.h"

extern "C" EXPORT
Behaviour * _Construct ( )
{
	DEBUG ( DebugLevel::WARN, "constructing @COMP@" );
	return new @COMP@ ( );
}

extern "C" EXPORT
void _Deconstruct ( Behaviour * b )
{
	DEBUG ( DebugLevel::WARN, "deconstructing @COMP@" );
	delete b;
}

extern "C" EXPORT
Reflection::Metadata _Metadata = @COMP@::metadata;
