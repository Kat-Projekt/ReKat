#include <catch2/catch_test_macros.hpp>
#include <catch2/matchers/catch_matchers_floating_point.hpp>
#include <catch2/reporters/catch_reporter_event_listener.hpp>
#include <catch2/reporters/catch_reporter_registrars.hpp>
#include <catch2/benchmark/catch_benchmark.hpp>

#include <thread>
#include <iostream>

#include <core/diagnostic/debugger.h>

template < typename fun >
void Call_Multiple ( fun function, int times )
{
	std::atomic < int  > started_threads = 0;
	std::atomic < bool > call = false;

	std::vector < std::thread > threads;
	threads.reserve ( times );

	for ( int i = 0; i < times; i ++ )
	{
		threads.emplace_back (
			[&] ( ) {
				started_threads += 1;
				// wait for start flagg
				while ( !call ) { std::this_thread::yield ( ); }
				function ( );
			}
		);
	}

	while ( started_threads != times )
	{ std::this_thread::yield ( ); }

	call = true;

	for ( auto & t : threads )
	{ t.join ( ); }
}

using namespace Catch::Matchers;

class Logger : public Catch::EventListenerBase {
public:
	using Catch::EventListenerBase::EventListenerBase;

	std::string Encapsulate ( const std::string & string, const std::string_view color )
	{
		std::string s = "[";
		s += ReKat::Debug::_print_colored (
			string.c_str ( ),
			color );
		s += "]";

		return s;
	}

	std::string Convert ( Catch::ResultDisposition::Flags result )
	{
		switch ( result )
		{
			case Catch::ResultDisposition::Normal: return "Normal"; break;
			case Catch::ResultDisposition::ContinueOnFailure: return "ContinueOnFailure"; break;
			case Catch::ResultDisposition::FalseTest: return "FalseTest"; break;
			case Catch::ResultDisposition::SuppressFail: return "SuppressFail"; break;
			default: return "?";
		}
		
	}

	void sectionStarting ( const Catch::SectionInfo & sectionInfo ) override 
	{
		ReKat::Debug::_debug_printer_out_wrapper (
			Encapsulate (
				sectionInfo.name.c_str ( ),
				ReKat::Debug::_Green ) +
			"\n------------------------------------------------------------------------------\n"
		);
	}

	void assertionStarting ( const Catch::AssertionInfo &Info ) override
	{
		ReKat::Debug::_debug_printer_out_wrapper (
			Encapsulate ( Info.macroName.operator std::__1::string ( ), ReKat::Debug::_Cyan )
			+ " " + Info.capturedExpression+ " -> " + Convert ( Info.resultDisposition ) + "\n"
		);
	}

	void assertionEnded ( const Catch::AssertionStats &Info ) override
	{
		ReKat::Debug::_debug_printer_out_wrapper (
			Encapsulate ( Info.assertionResult.getExpandedExpression ( ), ReKat::Debug::_Yellow )
			+ " -> " + 
			( Info.assertionResult.isOk ( ) ? 
				Encapsulate ( "v", ReKat::Debug::_Green ) :
				Encapsulate ( "x", ReKat::Debug::_Red )
			) + "\n"
		);
	}
};

CATCH_REGISTER_LISTENER ( Logger )
